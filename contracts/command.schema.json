{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay-liveloop.example/schemas/command.schema.json",
  "title": "Relay LiveLoop command envelope",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "verifyArguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkSetId"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checkSetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "checks": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object" } },
        "requirePocoSnapshot": { "type": "boolean" },
        "captureId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "nonce": { "type": "string", "minLength": 16, "maxLength": 256 },
        "requireFreshFrame": { "type": "boolean" },
        "expectedViewportGeneration": { "type": "integer", "minimum": 0 },
        "expectedOwnerGeneration": { "type": "integer", "minimum": 0 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "frameArtifactId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "minimumFrameExclusive": { "type": "integer", "minimum": 0 },
        "maximumWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "maximumHeight": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "requireViewport": { "type": "boolean" },
        "minimumWidth": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "minimumHeight": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "requireSafeArea": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "requireFreshFrame": { "const": true } } },
          "then": {
            "required": [
              "expectedViewportGeneration", "expectedOwnerGeneration", "targetId",
              "frameArtifactId", "minimumFrameExclusive", "maximumWidth", "maximumHeight"
            ]
          }
        },
        {
          "if": { "properties": { "requirePocoSnapshot": { "const": true } } },
          "then": { "required": ["captureId", "nonce"] }
        }
      ]
    }
  },
  "required": ["protocolVersion", "requestId", "operation", "arguments"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": {
      "type": "string",
      "enum": [
        "status", "task.open", "task.update", "task.show", "observe",
        "source.locate", "source.edit", "component.preview", "component.revert",
        "prepare", "task.approve", "iterate", "verify", "input.click", "input.text", "report",
        "baseline.build", "baseline.import", "player.start", "player.attach",
        "player.stop", "job.status", "job.cancel"
      ]
    },
    "taskId": { "type": ["string", "null"], "minLength": 1 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "expectedRuntimeRevision": { "type": "string", "minLength": 1 },
        "expectedLaunchId": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "arguments": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "required": ["operation"],
        "properties": { "operation": { "const": "verify" } }
      },
      "then": {
        "properties": { "arguments": { "$ref": "#/$defs/verifyArguments" } }
      }
    }
  ]
}
